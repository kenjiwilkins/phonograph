{
  "name": "phonograph",
  "description": "A spotify album player",
  "private": true,
  "version": "1.4.0",
  "license": "MIT",
  "author": {
    "name": "Michael Kenji Wilkins"
  },
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:CI": "vue-tsc --noEmit && vite build --mode test",
    "prettier": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/vue": "^11.17.0",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.16.0",
    "pinia": "^4.1.0",
    "vue": "^3.4.19"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@pinia/testing": "^2.0.2",
    "@sentry/vite-plugin": "^11.17.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/vue": "^8.0.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.0.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
